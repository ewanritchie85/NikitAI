# Copy this to .env and fill in your values.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Models

# Cheap/fast model for the orchestrator's routing classification
NIKITAI_ROUTER_MODEL=claude-haiku-4-5

# Optional per-sub-agent overrides. If unset, a sub-agent uses NIKITAI_DEFAULT_MODEL.
NIKITAI_ORGANISER_MODEL=claude-sonnet-5
NIKITAI_PLATFORM_NERD_MODEL=claude-sonnet-5
NIKITAI_TRAINER_MODEL=claude-sonnet-5
NIKITAI_HOME_WIZARD_MODEL=claude-haiku-4-5


# Azure App Registration
# Create one at https://portal.azure.com → App registrations
# Set platform: Mobile and desktop applications → redirect URI: https://login.microsoftonline.com/common/oauth2/nativeclient
AZURE_CLIENT_ID=your-azure-app-client-id

# Use "consumers" for personal Microsoft accounts (@outlook.com / @hotmail.com)
# Use your tenant ID or "organizations" for work/school accounts
AZURE_TENANT_ID=consumers


# Platform Nerd sub-agent
# Absolute path to a LOCAL folder (outside this repo) holding your private
# home-network / self-hosting notes as .txt files. The Platform Nerd sub-agent can
# read these and append confirmed config-change entries to existing files. Required
# only if you use the Platform Nerd sub-agent.
# NIKITAI_HOME_INFRA_NOTES_DIR=/path/to/your/notes/directory


# WiZ smart lighting config (Home Wizard sub-agent)
# Absolute path to a LOCAL JSON file (outside this repo) mapping friendly light
# names to their LAN IP addresses, e.g. {"bedroom lamp": "192.168.1.42", "desk light": "192.168.1.43"}.
# Required only if you use the Home Wizard sub-agent.
# NIKITAI_WIZ_LIGHTS_CONFIG=/path/to/your/wiz_lights.json


# Garmin Connect login credentials (Trainer sub-agent)
# WARNING: This uses Cyberjunky's UNOFFICIAL garminconnect client against the
# Garmin Connect web API with your real account credentials (not OAuth). Use a
# dedicated account, and do not reuse/password-share this account with anything
# sensitive. Required only if you use the Trainer sub-agent.
# GARMIN_CONNECT_USERNAME=you@example.com
# GARMIN_CONNECT_PASSWORD=your-garmin-password
# Cooldown (seconds) after a Garmin-side SSO block (HTTP 429 / Cloudflare 403 /
# CAPTCHA) before login is retried. Garmin's block is tied to the clientId +
# account, is extended by EVERY login attempt, and browser login still works;
# the observed recovery window is ~24h, so the default is 86400. While the
# cooldown is active, Trainer tool calls fail fast with no network access.
# Set to 0 to disable the persisted cooldown.
# NIKITAI_GARMIN_RATE_LIMIT_COOLDOWN=86400


# Web app login (single user). The web UI is login-gated and fails closed: without
# these set, the login page is shown but no credential can ever succeed.
# Generate the argon2id hash (never store the plaintext password):
#   python -m nikitai.web_auth "your-password"
# NIKITAI_WEB_USERNAME=your-username
# NIKITAI_WEB_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# Secret used to sign the session cookie. If unset, a random per-process secret is
# generated, which signs you out on every server restart. Set this to a long random
# string so sessions survive restarts (recommended once hosted).
# NIKITAI_WEB_SECRET=change-me-to-a-long-random-string
# Session lifetime in seconds (default 43200 = 12 hours).
# NIKITAI_WEB_SESSION_TTL=43200
# Set to true when serving over HTTPS so the session cookie is Secure-only.
# NIKITAI_WEB_HTTPS_ONLY=false